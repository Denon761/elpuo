# ------------------------------------------------------------------
# Elpuo — quote request email (nodemailer / SMTP)
# Copy this file to ".env.local" and fill in the values.
# ".env.local" is git-ignored and never committed.
# ------------------------------------------------------------------
# UploadThing — the quote form uploads reference designs here and submits the URL.
# Get this from the UploadThing dashboard → API Keys.
UPLOADTHING_TOKEN=your-uploadthing-token

# SMTP server that will send the mail
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 / 25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From: address on the outgoing mail (often must match SMTP_USER / a verified domain)
QUOTE_FROM_EMAIL="Elpuo Website <info@elpuo.com>"

# Where quote requests are delivered (your inbox). Comma-separate for multiple.
QUOTE_TO_EMAIL=info@elpuo.com

# Optional: shown to the customer on the confirmation screen
NEXT_PUBLIC_CONTACT_EMAIL=info@elpuo.com

# ------------------------------------------------------------------
# SEO / canonical site identity (src/lib/site.ts)
# ------------------------------------------------------------------
# Permanent public origin, no trailing slash. Drives canonical URLs,
# sitemap, robots and structured data. Set this in the production env
# so nothing points at a temporary *.vercel.app URL.
NEXT_PUBLIC_SITE_URL=https://www.elpuo.com

# Optional: phone number used in Organization / ContactPoint schema
NEXT_PUBLIC_CONTACT_PHONE=+1-000-000-0000

# Optional: Google tag / gtag.js ID (Google Ads or GA4). Defaults to the
# hard-coded Ads ID in src/app/layout.tsx if unset.
NEXT_PUBLIC_GTAG_ID=AW-18416026404
